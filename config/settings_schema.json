[
  {
    "name": "theme_info",
    "theme_name": "Ever-Shop",
    "theme_version": "1.0.0",
    "theme_author": "Theme Developer",
    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "Logo & Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Custom Logo Image"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 50,
        "max": 300,
        "step": 10,
        "unit": "px",
        "label": "Logo Width (Desktop)",
        "default": 140
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "font_picker",
        "id": "type_primary_font",
        "default": "work_sans_n4",
        "label": "Primary Font"
      },
      {
        "type": "font_picker",
        "id": "type_heading_font",
        "default": "work_sans_n6",
        "label": "Heading Font"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "color",
        "id": "background_color",
        "default": "#FFFFFF",
        "label": "Background Color"
      },
      {
        "type": "color",
        "id": "foreground_color",
        "default": "#222222",
        "label": "Text Color"
      },
      {
        "type": "color",
        "id": "color_primary_accent",
        "default": "#111111",
        "label": "Primary Accent / Button Color"
      },
      {
        "type": "color",
        "id": "color_border",
        "default": "#E5E5E5",
        "label": "Border Color"
      },
      {
        "type": "color",
        "id": "color_sale_badge",
        "default": "#C93A3A",
        "label": "Sale Badge Color"
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "select",
        "id": "max_page_width",
        "label": "Page Width",
        "options": [
          {
            "value": "80rem",
            "label": "Narrow (1280px)"
          },
          {
            "value": "90rem",
            "label": "Standard (1440px)"
          },
          {
            "value": "100rem",
            "label": "Wide (1600px)"
          }
        ],
        "default": "90rem"
      },
      {
        "type": "range",
        "id": "min_page_margin",
        "min": 10,
        "max": 60,
        "step": 2,
        "unit": "px",
        "label": "Page Margin",
        "default": 24
      },
      {
        "type": "range",
        "id": "input_corner_radius",
        "min": 0,
        "max": 12,
        "step": 1,
        "unit": "px",
        "label": "Button & Input Corner Radius",
        "default": 2
      }
    ]
  },
  {
    "name": "Cart Drawer",
    "settings": [
      {
        "type": "checkbox",
        "id": "cart_drawer_enabled",
        "label": "Enable AJAX Cart Drawer",
        "default": true
      },
      {
        "type": "number",
        "id": "free_shipping_threshold",
        "label": "Free Shipping Threshold ($)",
        "default": 75
      },
      {
        "type": "checkbox",
        "id": "cart_notes_enabled",
        "label": "Enable Order Notes",
        "default": true
      }
    ]
  },
  {
    "name": "Social Media Links",
    "settings": [
      {
        "type": "url",
        "id": "social_instagram_link",
        "label": "Instagram URL"
      },
      {
        "type": "url",
        "id": "social_facebook_link",
        "label": "Facebook URL"
      },
      {
        "type": "url",
        "id": "social_twitter_link",
        "label": "Twitter / X URL"
      },
      {
        "type": "url",
        "id": "social_pinterest_link",
        "label": "Pinterest URL"
      },
      {
        "type": "url",
        "id": "social_tiktok_link",
        "label": "TikTok URL"
      },
      {
        "type": "url",
        "id": "social_youtube_link",
        "label": "YouTube URL"
      }
    ]
  }
]
