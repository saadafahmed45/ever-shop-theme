{% doc %}
  Renders the interactive AJAX Cart Drawer slide-over.

  @example
  {% render 'cart-drawer' %}
{% enddoc %}

<div id="CartDrawerBackdrop" class="cart-drawer-backdrop" aria-hidden="true"></div>

<aside id="CartDrawer" class="cart-drawer" role="dialog" aria-modal="true" aria-labelledby="CartDrawerTitle" aria-hidden="true">
  <div class="cart-drawer__header">
    <h2 id="CartDrawerTitle" class="cart-drawer__title">Your Bag (<span class="js-cart-count">{{ cart.item_count }}</span>)</h2>
    <button type="button" class="cart-drawer__close js-drawer-close" aria-label="Close cart drawer">
      {% render 'icon', name: 'close', size: 18 %}
    </button>
  </div>

  <!-- Free shipping goal bar -->
  {% assign shipping_threshold = settings.free_shipping_threshold | default: 75 %}
  {% assign shipping_threshold_cents = shipping_threshold | times: 100 %}
  <div class="cart-drawer__shipping-bar js-shipping-bar" data-threshold="{{ shipping_threshold_cents }}">
    <div class="js-shipping-msg">
      {% if cart.total_price >= shipping_threshold_cents %}
        <span>🎉 You've unlocked <strong>Free Standard Shipping!</strong></span>
      {% else %}
        {% assign diff = shipping_threshold_cents | minus: cart.total_price %}
        <span>Add <strong>{{ diff | money }}</strong> more to unlock <strong>Free Shipping</strong></span>
      {% endif %}
    </div>
    <div class="cart-drawer__shipping-progress">
      {% assign progress_pct = cart.total_price | times: 100.0 | divided_by: shipping_threshold_cents | at_most: 100 %}
      <div class="cart-drawer__shipping-progress-bar js-shipping-progress" style="width: {{ progress_pct }}%;"></div>
    </div>
  </div>

  <!-- Items list -->
  <div class="cart-drawer__items js-cart-items">
    {% if cart.item_count > 0 %}
      {% for item in cart.items %}
        <div class="cart-drawer__item" data-key="{{ item.key }}">
          <a href="{{ item.url }}">
            {% if item.image %}
              <img
                src="{{ item.image | image_url: width: 160, height: 200, crop: 'center' }}"
                alt="{{ item.title | escape }}"
                width="80"
                height="100"
                loading="lazy"
                class="cart-drawer__item-img"
              >
            {% else %}
              <div class="cart-drawer__item-img" style="display:flex;align-items:center;justify-content:center;background:#eee;">
                {% render 'icon', name: 'cart', size: 24 %}
              </div>
            {% endif %}
          </a>

          <div class="cart-drawer__item-details">
            <div>
              <a href="{{ item.url }}" class="cart-drawer__item-title">{{ item.product.title }}</a>
              {% unless item.product.has_only_default_variant %}
                <div class="cart-drawer__item-variant">{{ item.variant.title }}</div>
              {% endunless %}
              <div class="cart-drawer__item-price">{{ item.final_line_price | money }}</div>
            </div>

            <div class="cart-drawer__item-actions">
              <div class="cart-drawer__qty-wrap">
                <button type="button" class="cart-drawer__qty-btn js-qty-btn" data-action="minus" data-key="{{ item.key }}" aria-label="Decrease quantity">-</button>
                <input type="number" class="cart-drawer__qty-input js-qty-input" data-key="{{ item.key }}" value="{{ item.quantity }}" min="0" aria-label="Item quantity">
                <button type="button" class="cart-drawer__qty-btn js-qty-btn" data-action="plus" data-key="{{ item.key }}" aria-label="Increase quantity">+</button>
              </div>

              <button type="button" class="cart-drawer__remove-btn js-remove-btn" data-key="{{ item.key }}">
                Remove
              </button>
            </div>
          </div>
        </div>
      {% endfor %}
    {% else %}
      <div class="cart-drawer__empty">
        <p>Your shopping bag is currently empty.</p>
        <a href="{{ routes.all_products_collection_url }}" class="btn btn-primary btn-sm js-drawer-close">
          Continue Shopping
        </a>
      </div>
    {% endif %}
  </div>

  <!-- Drawer Footer -->
  <div class="cart-drawer__footer js-cart-footer" {% if cart.item_count == 0 %}style="display: none;"{% endif %}>
    <div class="cart-drawer__subtotal">
      <span>Subtotal</span>
      <span class="js-cart-subtotal">{{ cart.total_price | money }}</span>
    </div>

    {% if cart.total_discounts > 0 %}
      <div class="cart-drawer__discounts">
        <span>Discounts</span>
        <span>-{{ cart.total_discounts | money }}</span>
      </div>
    {% endif %}

    <p class="cart-drawer__shipping-note">Taxes and shipping calculated at checkout.</p>

    <a href="/checkout" class="btn btn-primary cart-drawer__checkout-btn">
      Checkout &rarr;
    </a>

    <button type="button" class="cart-drawer__continue-btn js-drawer-close">
      or Continue Shopping
    </button>
  </div>
</aside>

<script>
  (function() {
    const drawer = document.getElementById('CartDrawer');
    const backdrop = document.getElementById('CartDrawerBackdrop');
    if (!drawer || !backdrop) return;

    window.openCartDrawer = function() {
      drawer.classList.add('is-open');
      backdrop.classList.add('is-open');
      drawer.setAttribute('aria-hidden', 'false');
      backdrop.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    };

    window.closeCartDrawer = function() {
      drawer.classList.remove('is-open');
      backdrop.classList.remove('is-open');
      drawer.setAttribute('aria-hidden', 'true');
      backdrop.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
    };

    backdrop.addEventListener('click', window.closeCartDrawer);

    document.addEventListener('click', function(e) {
      if (e.target.closest('.js-drawer-close')) {
        window.closeCartDrawer();
      }
      if (e.target.closest('.js-open-cart-drawer')) {
        e.preventDefault();
        window.openCartDrawer();
      }
    });

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && drawer.classList.contains('is-open')) {
        window.closeCartDrawer();
      }
    });

    // Helper: format money (using simple currency formatter)
    function formatMoney(cents) {
      return '$' + (cents / 100).toFixed(2);
    }

    // Refresh cart markup from /cart.js
    window.refreshCartDrawer = function() {
      fetch('/cart.js')
        .then(res => res.json())
        .then(cart => {
          if (window.updateCartCount) {
            window.updateCartCount(cart.item_count);
          }

          const countSpan = drawer.querySelector('.js-cart-count');
          if (countSpan) countSpan.textContent = cart.item_count;

          const itemsContainer = drawer.querySelector('.js-cart-items');
          const footer = drawer.querySelector('.js-cart-footer');
          const subtotalSpan = drawer.querySelector('.js-cart-subtotal');

          if (subtotalSpan) subtotalSpan.textContent = formatMoney(cart.total_price);

          // Update free shipping goal
          const shippingBar = drawer.querySelector('.js-shipping-bar');
          if (shippingBar) {
            const threshold = parseInt(shippingBar.getAttribute('data-threshold'), 10) || 7500;
            const progress = Math.min(100, Math.round((cart.total_price / threshold) * 100));
            const progressBar = drawer.querySelector('.js-shipping-progress');
            const msg = drawer.querySelector('.js-shipping-msg');

            if (progressBar) progressBar.style.width = progress + '%';
            if (msg) {
              if (cart.total_price >= threshold) {
                msg.innerHTML = "<span>🎉 You've unlocked <strong>Free Standard Shipping!</strong></span>";
              } else {
                const diff = threshold - cart.total_price;
                msg.innerHTML = "<span>Add <strong>" + formatMoney(diff) + "</strong> more to unlock <strong>Free Shipping</strong></span>";
              }
            }
          }

          if (cart.item_count === 0) {
            if (footer) footer.style.display = 'none';
            if (itemsContainer) {
              itemsContainer.innerHTML = `
                <div class="cart-drawer__empty">
                  <p>Your shopping bag is currently empty.</p>
                  <a href="{{ routes.all_products_collection_url }}" class="btn btn-primary btn-sm js-drawer-close">
                    Continue Shopping
                  </a>
                </div>
              `;
            }
            return;
          }

          if (footer) footer.style.display = 'block';

          let html = '';
          cart.items.forEach(item => {
            const variantHtml = item.variant_title && item.variant_title !== 'Default Title'
              ? `<div class="cart-drawer__item-variant">${item.variant_title}</div>`
              : '';

            const imgHtml = item.featured_image && item.featured_image.url
              ? `<img src="${item.featured_image.url}" alt="${item.title}" width="80" height="100" class="cart-drawer__item-img">`
              : `<div class="cart-drawer__item-img" style="display:flex;align-items:center;justify-content:center;background:#eee;">👜</div>`;

            html += `
              <div class="cart-drawer__item" data-key="${item.key}">
                <a href="${item.url}">${imgHtml}</a>
                <div class="cart-drawer__item-details">
                  <div>
                    <a href="${item.url}" class="cart-drawer__item-title">${item.product_title}</a>
                    ${variantHtml}
                    <div class="cart-drawer__item-price">${formatMoney(item.final_line_price)}</div>
                  </div>
                  <div class="cart-drawer__item-actions">
                    <div class="cart-drawer__qty-wrap">
                      <button type="button" class="cart-drawer__qty-btn js-qty-btn" data-action="minus" data-key="${item.key}">-</button>
                      <input type="number" class="cart-drawer__qty-input js-qty-input" data-key="${item.key}" value="${item.quantity}" min="0">
                      <button type="button" class="cart-drawer__qty-btn js-qty-btn" data-action="plus" data-key="${item.key}">+</button>
                    </div>
                    <button type="button" class="cart-drawer__remove-btn js-remove-btn" data-key="${item.key}">Remove</button>
                  </div>
                </div>
              </div>
            `;
          });

          if (itemsContainer) itemsContainer.innerHTML = html;
        });
    };

    // Quantity buttons & remove actions inside drawer
    drawer.addEventListener('click', function(e) {
      const qtyBtn = e.target.closest('.js-qty-btn');
      if (qtyBtn) {
        const key = qtyBtn.getAttribute('data-key');
        const action = qtyBtn.getAttribute('data-action');
        const input = drawer.querySelector(`.js-qty-input[data-key="${key}"]`);
        if (!input) return;
        let currentQty = parseInt(input.value, 10) || 0;
        let newQty = action === 'plus' ? currentQty + 1 : Math.max(0, currentQty - 1);
        updateItemQuantity(key, newQty);
        return;
      }

      const removeBtn = e.target.closest('.js-remove-btn');
      if (removeBtn) {
        const key = removeBtn.getAttribute('data-key');
        updateItemQuantity(key, 0);
      }
    });

    drawer.addEventListener('change', function(e) {
      const input = e.target.closest('.js-qty-input');
      if (input) {
        const key = input.getAttribute('data-key');
        const newQty = parseInt(input.value, 10) || 0;
        updateItemQuantity(key, newQty);
      }
    });

    function updateItemQuantity(key, quantity) {
      fetch('/cart/change.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id: key, quantity: quantity })
      })
      .then(res => res.json())
      .then(() => {
        window.refreshCartDrawer();
      })
      .catch(err => console.error('Cart update error:', err));
    }

    // Intercept Quick Add clicks globally
    document.addEventListener('click', function(e) {
      const quickAddBtn = e.target.closest('.js-quick-add');
      if (quickAddBtn) {
        e.preventDefault();
        const variantId = quickAddBtn.getAttribute('data-variant-id');
        if (!variantId) return;

        const originalText = quickAddBtn.textContent;
        quickAddBtn.textContent = 'Adding...';
        quickAddBtn.disabled = true;

        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: variantId, quantity: 1 })
        })
        .then(res => res.json())
        .then(() => {
          quickAddBtn.textContent = 'Added ✓';
          window.refreshCartDrawer();
          window.openCartDrawer();
          if (window.showToast) window.showToast('Item added to your bag!');
          setTimeout(() => {
            quickAddBtn.textContent = originalText;
            quickAddBtn.disabled = false;
          }, 1500);
        })
        .catch(err => {
          console.error('Quick Add error:', err);
          quickAddBtn.textContent = originalText;
          quickAddBtn.disabled = false;
          if (window.showToast) window.showToast('Error adding item.');
        });
      }
    });

  })();
</script>
