<div class="sub_header d-none d-lg-block"> <div class="container">
    <ul class="nav justify-content-center">
      {%- for link in section.settings.menu.links -%}
        <li class="nav-item">
          <a href="{{ link.url }}" class="nav-link">{{ link.title }}</a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

<style>
  .sub_header {
    background-color: #f8f9fa;
    border-bottom: 1px solid #eee;
    padding: 5px 0;
  }
  .sub_header .nav-link {
    color: #555;
    font-size: 13px;
    text-transform: uppercase;
    font-weight: 500;
  }
  
  /* Bootstrap's 'd-none d-lg-block' class mobile-e automatic hide kore dibe */
</style>

{% schema %}
{
  "name": "Sub-Header",
  "settings": [
    { "type": "link_list", "id": "menu", "label": "Select Menu" }
  ],
  "presets": [{ "name": "Sub-Header" }]
}
{% endschema %}