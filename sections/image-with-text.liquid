{%- liquid
  assign img = section.settings.image
  assign layout_dir = section.settings.image_position
-%}

<div class="image-with-text-section" id="ImageWithText-{{ section.id }}">
  <div class="container">
    <div class="image-with-text__wrapper image-with-text--{{ layout_dir }}">

      <!-- MEDIA -->
      <div class="image-with-text__media">
        {% if img != blank %}
          {% render 'image', image: img, class: 'image-with-text__img' %}
        {% else %}
          <div class="image-with-text__placeholder">
            {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
          </div>
        {% endif %}
      </div>

      <!-- CONTENT -->
      <div class="image-with-text__content">
        {% if section.settings.eyebrow != blank %}
          <span class="image-with-text__eyebrow">{{ section.settings.eyebrow }}</span>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="image-with-text__heading">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.text != blank %}
          <div class="image-with-text__text rte">
            {{ section.settings.text }}
          </div>
        {% endif %}

        {% if section.settings.button_label != blank and section.settings.button_link != blank %}
          <div class="image-with-text__btn-wrap">
            <a href="{{ section.settings.button_link }}" class="btn btn-primary">
              {{ section.settings.button_label }}
            </a>
          </div>
        {% endif %}
      </div>

    </div>
  </div>
</div>

{% stylesheet %}
  .image-with-text-section {
    padding: 70px 0;
    background-color: #ffffff;
  }

  .image-with-text__wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 60px;
    align-items: center;
  }

  .image-with-text--right {
    direction: rtl;
  }

  .image-with-text--right > * {
    direction: ltr;
  }

  .image-with-text__media {
    position: relative;
    border-radius: var(--style-border-radius-inputs, 4px);
    overflow: hidden;
    background-color: #f6f6f6;
    aspect-ratio: 4 / 3;
  }

  .image-with-text__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .image-with-text__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .image-with-text__content {
    display: flex;
    flex-direction: column;
    max-width: 520px;
  }

  .image-with-text__eyebrow {
    font-size: 0.8rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #777777;
    margin-bottom: 12px;
  }

  .image-with-text__heading {
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    font-weight: 600;
    line-height: 1.25;
    margin-bottom: 18px;
  }

  .image-with-text__text {
    font-size: 1rem;
    line-height: 1.6;
    color: #555555;
    margin-bottom: 28px;
  }

  @media (max-width: 992px) {
    .image-with-text__wrapper {
      grid-template-columns: 1fr;
      gap: 36px;
      direction: ltr !important;
    }
    .image-with-text__content {
      max-width: 100%;
    }
  }

  @media (max-width: 768px) {
    .image-with-text-section {
      padding: 48px 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Image with Text",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image Position",
      "options": [
        { "value": "left", "label": "Image Left" },
        { "value": "right", "label": "Image Right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow / Subtitle",
      "default": "OUR COMMITMENT"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Radical Transparency in Everything We Do"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Description",
      "default": "<p>We believe customers have a right to know how their clothes are made, where they come from, and what they really cost to produce.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Read Our Story"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Image with Text"
    }
  ]
}
{% endschema %}
