<div class="everlane-favorites">
  <div class="container">

    <!-- HEADER -->
    <div class="fav-header">
      <h2>{{ section.settings.title }}</h2>
      <p>{{ section.settings.subtitle }}</p>
    </div>

    <!-- SWIPER -->
    <div class="swiper favSwiper">
      <div class="swiper-wrapper">

        {% if section.settings.collection != blank %}
          {% for product in section.settings.collection.products %}
          <div class="swiper-slide">

            <div class="fav-card">
              <a href="{{ product.url }}">

                <div class="fav-img">
                  {% if product.featured_image %}
                    <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title }}">
                  {% else %}
                    {{ 'product-1' | placeholder_svg_tag }}
                  {% endif %}
                </div>

                <div class="fav-info">
                  <div class="fav-title">
                    {{ product.title | truncate: 40 }}
                  </div>
                  <div class="fav-price">
                    {{ product.price | money }}
                  </div>
                </div>

              </a>
            </div>

          </div>
          {% endfor %}
        {% endif %}

      </div>

      <!-- ARROWS -->
      <div class="swiper-button-next"></div>
      <div class="swiper-button-prev"></div>

      <!-- DOTS -->
      <div class="swiper-pagination"></div>
    </div>

  </div>
</div>


<!-- STYLE -->
<style>
.everlane-favorites {
  padding: 80px 0;
  background: #fff;
}

.container {
  max-width: 1300px;
  margin: auto;
  padding: 0 15px;
}

.fav-header {
  text-align: center;
  margin-bottom: 40px;
}

.fav-header h2 {
  font-size: 26px;
  font-weight: 500;
  letter-spacing: 1px;
}

.fav-header p {
  font-size: 14px;
  color: #666;
  margin-top: 10px;
}

/* CARD */
.fav-card {
  transition: 0.3s;
}

.fav-card:hover {
  transform: translateY(-5px);
}

.fav-img {
  background: #eee;
  overflow: hidden;
}

.fav-img img {
  width: 100%;
  height: 320px;
  object-fit: cover;
  transition: 0.3s;
}

.fav-card:hover img {
  transform: scale(1.05);
}

/* INFO */
.fav-info {
  padding: 10px 5px;
  display: flex;
  justify-content: space-between;
  font-size: 13px;
  color: #333;
}

.fav-title {
  max-width: 70%;
}

.fav-price {
  font-weight: 500;
}

/* SWIPER */
.swiper {
  padding-bottom: 40px;
}

.swiper-slide {
  width: auto;
}

/* ARROWS */
.swiper-button-next,
.swiper-button-prev {
  color: #000;
}

/* DOTS */
.swiper-pagination-bullet {
  background: #999;
}

.swiper-pagination-bullet-active {
  background: #000;
}

/* RESPONSIVE */
@media (max-width: 992px) {
  .fav-img img {
    height: 260px;
  }
}

@media (max-width: 768px) {
  .fav-img img {
    height: 220px;
  }
}
</style>

<!-- SWIPER JS CDN -->

<!-- INIT -->
<script>
document.addEventListener("DOMContentLoaded", function () {
  new Swiper(".favSwiper", {
    slidesPerView: 5,
    spaceBetween: 20,
    loop: true,

    navigation: {
      nextEl: ".swiper-button-next",
      prevEl: ".swiper-button-prev",
    },

    pagination: {
      el: ".swiper-pagination",
      clickable: true,
    },

    breakpoints: {
      320: { slidesPerView: 1.5 },
      576: { slidesPerView: 2 },
      768: { slidesPerView: 3 },
      992: { slidesPerView: 4 },
      1200: { slidesPerView: 5 },
    },
  });
});
</script>

{% schema %}
{
  "name": "Everlane Favorites Slider",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Everlane Favorites"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Sub Heading",
      "default": "Beautifully Functional. Purposefully Designed. Consciously Crafted."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    }
  ],
  "presets": [
    {
      "name": "Everlane Favorites Slider"
    }
  ]
}
{% endschema %}