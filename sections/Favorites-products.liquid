{%- liquid
  assign collection = section.settings.collection
  assign products_to_show = section.settings.products_to_show | default: 8
-%}

<div class="everlane-favorites" id="Favorites-{{ section.id }}">
  <div class="container">

    <!-- HEADER -->
    {% if section.settings.title != blank or section.settings.subtitle != blank %}
      <div class="fav-header text-center">
        {% if section.settings.title != blank %}
          <h2 class="fav-header__title">{{ section.settings.title }}</h2>
        {% endif %}
        {% if section.settings.subtitle != blank %}
          <p class="fav-header__subtitle text-muted">{{ section.settings.subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    <!-- SWIPER CAROUSEL -->
    <div class="fav-slider-wrapper">
      <div class="swiper favSwiper" id="favSwiper-{{ section.id }}">
        <div class="swiper-wrapper">

          {% if collection != blank and collection.products.size > 0 %}
            {% for product in collection.products limit: products_to_show %}
              <div class="swiper-slide">
                {% render 'product-card', product: product %}
              </div>
            {% endfor %}
          {% else %}
            {% for i in (1..6) %}
              <div class="swiper-slide">
                <div class="product-card">
                  <div class="product-card__media">
                    <div class="product-card__placeholder">
                      {{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}
                    </div>
                  </div>
                  <div class="product-card__info">
                    <div class="product-card__vendor">Everlane</div>
                    <h3 class="product-card__title">Sample Product Title {{ i }}</h3>
                    <div class="product-card__price">$98.00</div>
                  </div>
                </div>
              </div>
            {% endfor %}
          {% endif %}

        </div>

        <!-- ARROWS -->
        <button type="button" class="swiper-button-prev fav-nav-btn fav-nav-prev-{{ section.id }}" aria-label="Previous slide"></button>
        <button type="button" class="swiper-button-next fav-nav-btn fav-nav-next-{{ section.id }}" aria-label="Next slide"></button>

        <!-- PAGINATION -->
        <div class="swiper-pagination fav-pagination-{{ section.id }}"></div>
      </div>
    </div>

  </div>
</div>

<script>
  (function() {
    function initSwiper_{{ section.id | replace: '-', '_' }}() {
      const swiperEl = document.getElementById('favSwiper-{{ section.id }}');
      if (!swiperEl || typeof Swiper === 'undefined') return;

      if (swiperEl.swiper) {
        swiperEl.swiper.destroy(true, true);
      }

      new Swiper(swiperEl, {
        slidesPerView: 1.3,
        spaceBetween: 16,
        grabCursor: true,
        navigation: {
          nextEl: '.fav-nav-next-{{ section.id }}',
          prevEl: '.fav-nav-prev-{{ section.id }}',
        },
        pagination: {
          el: '.fav-pagination-{{ section.id }}',
          clickable: true,
        },
        breakpoints: {
          480: {
            slidesPerView: 2,
            spaceBetween: 16,
          },
          768: {
            slidesPerView: 3,
            spaceBetween: 20,
          },
          992: {
            slidesPerView: 4,
            spaceBetween: 24,
          },
          1200: {
            slidesPerView: 4,
            spaceBetween: 24,
          }
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSwiper_{{ section.id | replace: '-', '_' }});
    } else {
      initSwiper_{{ section.id | replace: '-', '_' }}();
    }

    // Shopify Theme Editor Integration
    document.addEventListener('shopify:section:load', function(e) {
      if (e.detail.sectionId === '{{ section.id }}') {
        initSwiper_{{ section.id | replace: '-', '_' }}();
      }
    });
  })();
</script>

{% stylesheet %}
  .everlane-favorites {
    padding: 70px 0;
    background-color: #ffffff;
  }

  .fav-header {
    margin-bottom: 36px;
  }

  .fav-header__title {
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    font-weight: 600;
    margin-bottom: 8px;
  }

  .fav-header__subtitle {
    font-size: 0.95rem;
  }

  .fav-slider-wrapper {
    position: relative;
  }

  .favSwiper {
    padding-bottom: 44px;
  }

  .fav-nav-btn {
    width: 40px;
    height: 40px;
    background: #ffffff;
    border-radius: 50%;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
    color: #111111;
    transition: all 0.2s ease;
  }

  .fav-nav-btn::after {
    font-size: 14px;
    font-weight: bold;
  }

  .fav-nav-btn:hover {
    background: #111111;
    color: #ffffff;
  }

  .swiper-pagination-bullet-active {
    background: #111111 !important;
  }

  @media (max-width: 768px) {
    .everlane-favorites {
      padding: 48px 0;
    }
    .fav-nav-btn {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Featured Products Slider",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Everlane Favorites"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Sub Heading",
      "default": "Beautifully Functional. Purposefully Designed. Consciously Crafted."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 16,
      "step": 2,
      "label": "Maximum Products to Show",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Featured Products Slider"
    }
  ]
}
{% endschema %}