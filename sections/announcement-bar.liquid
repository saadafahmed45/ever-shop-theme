{% if section.settings.enable_announcement %}
  <div
    class="announcement-bar"
    style="
      --announcement-bg: {{ section.settings.background_color }};
      --announcement-color: {{ section.settings.text_color }};
      --announcement-align: {{ section.settings.text_alignment }};
      --announcement-height-desktop: {{ section.settings.desktop_height }}px;
      --announcement-height-mobile: {{ section.settings.mobile_height }}px;
    "
    id="AnnouncementBar-{{ section.id }}"
    data-autoplay="{{ section.settings.autoplay }}"
    data-speed="{{ section.settings.autoplay_speed | times: 1000 }}"
  >
    <div class="container announcement-bar__container">
      {% if section.blocks.size > 0 %}
        <div class="announcement-bar__slider js-announcement-slider">
          {% for block in section.blocks %}
            <div class="announcement-bar__item {% if forloop.first %}is-active{% endif %}" {{ block.shopify_attributes }}>
              {% if block.settings.link != blank %}
                <a href="{{ block.settings.link }}" class="announcement-bar__link">
                  {{ block.settings.text }}
                </a>
              {% else %}
                <span class="announcement-bar__text">{{ block.settings.text }}</span>
              {% endif %}
            </div>
          {% endfor %}
        </div>
      {% else %}
        <div class="announcement-bar__item is-active">
          {% if section.settings.announcement_link != blank %}
            <a href="{{ section.settings.announcement_link }}" class="announcement-bar__link">
              {{ section.settings.announcement_text }}
            </a>
          {% else %}
            <span class="announcement-bar__text">{{ section.settings.announcement_text }}</span>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>

  <script>
    (function() {
      const bar = document.getElementById('AnnouncementBar-{{ section.id }}');
      if (!bar) return;
      const isAutoplay = bar.getAttribute('data-autoplay') === 'true';
      const speed = parseInt(bar.getAttribute('data-speed'), 10) || 4000;
      const items = bar.querySelectorAll('.announcement-bar__item');

      if (isAutoplay && items.length > 1) {
        let currentIndex = 0;
        setInterval(() => {
          items[currentIndex].classList.remove('is-active');
          currentIndex = (currentIndex + 1) % items.length;
          items[currentIndex].classList.add('is-active');
        }, speed);
      }
    })();
  </script>
{% endif %}

{% stylesheet %}
  .announcement-bar {
    background-color: var(--announcement-bg, #111111);
    color: var(--announcement-color, #ffffff);
    min-height: var(--announcement-height-desktop, 38px);
    display: flex;
    align-items: center;
    position: relative;
    z-index: 100;
    overflow: hidden;
  }

  .announcement-bar__container {
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: var(--announcement-align, center);
    height: 100%;
  }

  .announcement-bar__slider {
    position: relative;
    width: 100%;
    min-height: var(--announcement-height-desktop, 38px);
    display: flex;
    align-items: center;
    justify-content: var(--announcement-align, center);
  }

  .announcement-bar__item {
    display: none;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    width: 100%;
    animation: fadeInAnnouncement 0.4s ease;
  }

  .announcement-bar__item.is-active {
    display: block;
  }

  .announcement-bar__link,
  .announcement-bar__text {
    color: inherit;
    text-decoration: none;
  }

  .announcement-bar__link:hover {
    text-decoration: underline;
  }

  @keyframes fadeInAnnouncement {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 768px) {
    .announcement-bar {
      min-height: var(--announcement-height-mobile, 34px);
    }
    .announcement-bar__slider {
      min-height: var(--announcement-height-mobile, 34px);
    }
    .announcement-bar__item {
      font-size: 0.75rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable_announcement",
      "label": "Enable Announcement Bar",
      "default": true
    },
    {
      "type": "text",
      "id": "announcement_text",
      "label": "Default Announcement Text",
      "default": "Free Shipping on Orders Over $75"
    },
    {
      "type": "url",
      "id": "announcement_link",
      "label": "Announcement Link"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay (Multiple Announcements)",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_speed",
      "label": "Autoplay Speed (Seconds)",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 4
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "desktop_height",
      "label": "Desktop Height",
      "min": 28,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 38
    },
    {
      "type": "range",
      "id": "mobile_height",
      "label": "Mobile Height",
      "min": 24,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 34
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement Slide",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Announcement Text",
          "default": "Consciously Crafted Sustainable Essentials"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar",
      "blocks": [
        {
          "type": "announcement",
          "settings": {
            "text": "Free Shipping on Orders Over $75"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "New Winter Collection — Explore Now"
          }
        }
      ]
    }
  ]
}
{% endschema %}