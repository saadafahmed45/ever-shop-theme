<div class="custom-footer">

  <div class="footer-container">

    <!-- LEFT LINKS -->
    <div class="footer-grid">

      <!-- ACCOUNT -->
      <div class="footer-col">
        <h4>Account</h4>
        <a href="#">Log In</a>
        <a href="#">Sign Up</a>
        <a href="#">Redeem a Gift Card</a>
      </div>

      <!-- COMPANY -->
      <div class="footer-col">
        <h4>Company</h4>
        <a href="#">About</a>
        <a href="#">Environmental Initiatives</a>
        <a href="#">Factories</a>
        <a href="#">Careers</a>
      </div>

      <!-- HELP -->
      <div class="footer-col">
        <h4>Get Help</h4>
        <a href="#">Help Center</a>
        <a href="#">Return Policy</a>
        <a href="#">Shipping Info</a>
        <a href="#">Bulk Orders</a>
      </div>

      <!-- CONNECT -->
      <div class="footer-col">
        <h4>Connect</h4>
        <a href="#">Facebook</a>
        <a href="#">Instagram</a>
        <a href="#">Twitter</a>
        <a href="#">Affiliates</a>
      </div>

    </div>

    <!-- NEWSLETTER -->
    <div class="footer-newsletter">
      <form>
        <input type="email" placeholder="Email Address">
        <button type="submit">→</button>
      </form>
    </div>

  </div>

  <!-- BOTTOM -->
  <div class="footer-bottom">
    <div class="footer-links">
      <a href="#">Privacy Policy</a>
      <a href="#">Terms of Service</a>
      <a href="#">Do Not Sell My Info</a>
      <a href="#">Sitemap</a>
    </div>

    <p>© {{ 'now' | date: "%Y" }} All Rights Reserved</p>
  </div>

</div>

{% stylesheet %}
  .custom-footer {
  background: #f5f5f5;
  padding: 50px 20px 30px;
  font-family: sans-serif;
}

/* CONTAINER */
.footer-container {
  max-width: 1200px;
  margin: auto;
  display: flex;
  justify-content: space-between;
  gap: 40px;
}

/* GRID */
.footer-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 40px;
  flex: 1;
}

/* COLUMN */
.footer-col h4 {
  font-size: 14px;
  margin-bottom: 10px;
  color: #111;
}

.footer-col a {
  display: block;
  font-size: 13px;
  color: #777;
  text-decoration: none;
  margin-bottom: 6px;
}

.footer-col a:hover {
  color: #111;
}

/* NEWSLETTER */
.footer-newsletter form {
  display: flex;
  align-items: center;
}

.footer-newsletter input {
  padding: 12px;
  border: none;
  width: 250px;
  background: #eaeaea;
}

.footer-newsletter button {
  padding: 12px 16px;
  border: none;
  background: #111;
  color: #fff;
  cursor: pointer;
}

/* BOTTOM */
.footer-bottom {
  max-width: 1200px;
  margin: 40px auto 0;
  border-top: 1px solid #ddd;
  padding-top: 20px;
  text-align: center;
}

.footer-links {
  margin-bottom: 10px;
}

.footer-links a {
  margin: 0 10px;
  font-size: 12px;
  color: #777;
  text-decoration: none;
}

.footer-links a:hover {
  color: #111;
}

.footer-bottom p {
  font-size: 12px;
  color: #999;
}

/* MOBILE */
@media (max-width: 768px) {
  .footer-container {
    flex-direction: column;
  }

  .footer-grid {
    grid-template-columns: repeat(2, 1fr);
  }

  .footer-newsletter input {
    width: 100%;
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.footer",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:labels.menu"
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "t:labels.show_payment_icons",
      "default": true
    }
  ]
}
{% endschema %}
