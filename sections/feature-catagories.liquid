<div class="feature_categories py-5">
  <div class="container">

    <!-- SECTION HEADER -->
    <div class="text-center mb-4">
      <h2 class="fw-bold">{{ section.settings.heading }}</h2>
      <p class="text-muted">{{ section.settings.sub_heading }}</p>
    </div>

    <div class="row">
      {% for block in section.blocks %}
        {% assign collection = block.settings.collection_link %}

        {% if collection != blank %}
        <div class="col-6 col-md-4 col-lg-3 mb-4">
          
          <a href="{{ collection.url }}" class="category-card text-center">

            <!-- IMAGE -->
            {% if collection.image %}
              <img 
                src="{{ collection.image | img_url: 'medium' }}" 
                alt="{{ collection.title }}" 
                class="category-img">
            {% else %}
              <img 
                src="{{ collection.products.first.featured_image | img_url: 'medium' }}" 
                alt="{{ collection.title }}" 
                class="category-img">
            {% endif %}

            <!-- TITLE -->
            <h6 class="category-title mt-3">
              {{ collection.title }}
            </h6>

          </a>

        </div>
        {% endif %}
      {% endfor %}
    </div>

  </div>
</div>

<style>

/* CARD */
.category-card {
  display: block;
  padding: 10px;
  border-radius: 5px;
  background: #fff;
  text-decoration: none;
  transition: all 0.3s ease;
}

/* HOVER EFFECT 🔥 */
.category-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 10px 25px rgba(0,0,0,0.08);
}

/* IMAGE */
.category-img {
  width: 100%;
  height: auto;
  /* object-fit: cover; */
  border-radius: 5px;
}

/* TITLE */
.category-title {
  font-size: 20px;
  font-weight: 600;
  color: #333;
  transition: 0.3s;
}

.category-card:hover .category-title {
  color: #000;
}

</style>

{% schema %}
{
  "name": "Feature Categories",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by Categories"
    },
    {
      "type": "text",
      "id": "sub_heading",
      "label": "Sub Heading",
      "default": "Explore our wide range of products"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "collection",
          "id": "collection_link",
          "label": "Select Collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature Categories"
    }
  ]
}
{% endschema %}