{%- liquid
  assign desktop_image = section.settings.image
  assign mobile_image = section.settings.mobile_image | default: desktop_image
  assign overlay_opacity = section.settings.overlay_opacity | divided_by: 100.0
-%}

<section
  class="hero-section hero-section--{{ section.settings.height }} hero-section--valign-{{ section.settings.vertical_alignment }} hero-section--align-{{ section.settings.text_alignment }}"
  id="Hero-{{ section.id }}"
  style="
    --hero-overlay-bg: {{ section.settings.overlay_color }};
    --hero-overlay-opacity: {{ overlay_opacity }};
    --hero-text-color: {{ section.settings.text_color }};
  "
>
  <!-- BACKGROUND IMAGES -->
  <div class="hero-section__media">
    {% if desktop_image != blank %}
      <picture>
        {% if mobile_image != blank %}
          <source media="(max-width: 767px)" srcset="{{ mobile_image | image_url: width: 800 }}">
        {% endif %}
        <img
          src="{{ desktop_image | image_url: width: 2000 }}"
          alt="{{ desktop_image.alt | default: section.settings.title | escape }}"
          width="2000"
          height="{{ 2000 | divided_by: desktop_image.aspect_ratio | round }}"
          loading="eager"
          class="hero-section__image"
        >
      </picture>
    {% else %}
      <div class="hero-section__placeholder">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
      </div>
    {% endif %}
    <div class="hero-section__overlay"></div>
  </div>

  <!-- CONTENT -->
  <div class="container hero-section__container">
    <div class="hero-section__content">
      {% if section.settings.subtext_top != blank %}
        <p class="hero-section__subtext-top">{{ section.settings.subtext_top }}</p>
      {% endif %}

      {% if section.settings.title != blank %}
        <h1 class="hero-section__title">{{ section.settings.title }}</h1>
      {% endif %}

      {% if section.settings.subtext != blank %}
        <p class="hero-section__subtext">{{ section.settings.subtext }}</p>
      {% endif %}

      {% if section.settings.btn_label != blank or section.settings.secondary_btn_label != blank %}
        <div class="hero-section__buttons">
          {% if section.settings.btn_label != blank %}
            <a href="{{ section.settings.btn_link | default: '#' }}" class="btn btn-hero-primary">
              {{ section.settings.btn_label }}
            </a>
          {% endif %}

          {% if section.settings.secondary_btn_label != blank %}
            <a href="{{ section.settings.secondary_btn_link | default: '#' }}" class="btn btn-hero-secondary">
              {{ section.settings.secondary_btn_label }}
            </a>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .hero-section {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    color: var(--hero-text-color, #ffffff);
  }

  .hero-section--small { min-height: 50vh; }
  .hero-section--medium { min-height: 70vh; }
  .hero-section--large { min-height: 85vh; }
  .hero-section--full { min-height: 100vh; }

  /* Vertical Alignment */
  .hero-section--valign-top { align-items: flex-start; padding-top: 80px; }
  .hero-section--valign-center { align-items: center; }
  .hero-section--valign-bottom { align-items: flex-end; padding-bottom: 80px; }

  /* Horizontal Alignment */
  .hero-section--align-left .hero-section__content { text-align: left; margin-right: auto; }
  .hero-section--align-center .hero-section__content { text-align: center; margin-left: auto; margin-right: auto; }
  .hero-section--align-right .hero-section__content { text-align: right; margin-left: auto; }

  .hero-section__media {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  .hero-section__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-section__placeholder {
    width: 100%;
    height: 100%;
    background-color: #2b2b2b;
  }

  .hero-section__overlay {
    position: absolute;
    inset: 0;
    background-color: var(--hero-overlay-bg, #000000);
    opacity: var(--hero-overlay-opacity, 0.3);
  }

  .hero-section__container {
    position: relative;
    z-index: 2;
    padding-top: 40px;
    padding-bottom: 40px;
  }

  .hero-section__content {
    max-width: 620px;
  }

  .hero-section__subtext-top {
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 600;
    margin-bottom: 12px;
    opacity: 0.95;
  }

  .hero-section__title {
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: inherit;
    margin-bottom: 16px;
  }

  .hero-section__subtext {
    font-size: clamp(1rem, 2vw, 1.25rem);
    line-height: 1.5;
    margin-bottom: 28px;
    opacity: 0.92;
  }

  .hero-section__buttons {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .btn-hero-primary {
    background-color: #ffffff;
    color: #111111;
    border-color: #ffffff;
    padding: 14px 36px;
  }

  .btn-hero-primary:hover {
    background-color: #f0f0f0;
    color: #111111;
  }

  .btn-hero-secondary {
    background-color: transparent;
    color: #ffffff;
    border-color: #ffffff;
    padding: 14px 36px;
  }

  .btn-hero-secondary:hover {
    background-color: #ffffff;
    color: #111111;
  }

  @media (max-width: 768px) {
    .hero-section {
      min-height: 60vh !important;
      align-items: center !important;
      padding-top: 40px !important;
      padding-bottom: 40px !important;
    }
    .hero-section--align-left .hero-section__content,
    .hero-section--align-right .hero-section__content {
      text-align: center;
      margin: 0 auto;
    }
    .hero-section__buttons {
      justify-content: center;
      width: 100%;
    }
    .hero-section__buttons .btn {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero Section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Desktop Background Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Background Image (Optional)"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Section Height",
      "options": [
        { "value": "small", "label": "Small (50vh)" },
        { "value": "medium", "label": "Medium (70vh)" },
        { "value": "large", "label": "Large (85vh)" },
        { "value": "full", "label": "Full Screen (100vh)" }
      ],
      "default": "large"
    },
    {
      "type": "text",
      "id": "subtext_top",
      "label": "Eyebrow / Subtitle",
      "default": "NEW ARRIVALS"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Your Cozy Era"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Get peak comfy-chic with new winter essentials consciously crafted to last."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Primary Button Text",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "secondary_btn_label",
      "label": "Secondary Button Text"
    },
    {
      "type": "url",
      "id": "secondary_btn_link",
      "label": "Secondary Button Link"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Vertical Alignment",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "label": "Overlay Opacity",
      "default": 30
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Hero Section"
    }
  ]
}
{% endschema %}