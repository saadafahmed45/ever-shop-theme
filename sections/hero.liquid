<section class="hero-container position-relative d-flex align-items-center" 
         style="min-height: {{ section.settings.hero_height }}vh; background: url('{{ section.settings.image | img_url: '2000x' }}') center/cover no-repeat;">
  
  <div class="hero-overlay position-absolute top-0 start-0 w-100 h-100"></div>

  <div class="container position-relative text-white" style="z-index: 2;">
    <div class="row">
      <div class="col-12 col-md-7 col-lg-5">
        <h1 class="hero-title display-3 mb-3">{{ section.settings.title }}</h1>
        <p class="hero-subtext lead mb-5">{{ section.settings.subtext }}</p>
        
        {% if section.settings.btn_label != blank %}
          <a href="{{ section.settings.btn_link }}" class="btn btn-hero">
            {{ section.settings.btn_label }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<style>
  .hero-overlay {
    background: linear-gradient(90deg, rgba(0,0,0,0.4) 0%, rgba(0,0,0,0.1) 60%);
  }
  
  .hero-title {
    font-family: 'Courier New', Courier, monospace; /* Typewriter style */
    font-weight: 400;
  }
  
  .hero-subtext {
    font-family: 'Courier New', Courier, monospace;
    opacity: 0.9;
    letter-spacing: 0.5px;
  }

  .btn-hero {
    background: #fff;
    color: #000;
    border-radius: 0;
    padding: 12px 40px;
    font-weight: bold;
    text-transform: uppercase;
    font-size: 0.8rem;
    letter-spacing: 2px;
    border: none;
    transition: all 0.3s ease;
  }

  .btn-hero:hover {
    background: #f0f0f0;
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .hero-container { text-align: center; min-height: 60vh !important; }
    .hero-overlay { background: rgba(0,0,0,0.3); }
    .display-3 { font-size: 2.5rem; }
  }
</style>

{% schema %}
{
  "name": "Hero Section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background Image"
    },
    {
      "type": "range",
      "id": "hero_height",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "label": "Section Height",
      "default": 80
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "Your Cozy Era"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Get peak comfy-chic with new winter essentials."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "SHOP NOW"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Hero Section"
    }
  ]
}
{% endschema %}