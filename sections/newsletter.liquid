<div
  class="newsletter-section text-center"
  id="Newsletter-{{ section.id }}"
  style="
    --newsletter-bg: {{ section.settings.background_color }};
    --newsletter-color: {{ section.settings.text_color }};
  "
>
  <div class="container container-narrow">
    {% if section.settings.heading != blank %}
      <h2 class="newsletter-section__title">{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.subtext != blank %}
      <p class="newsletter-section__subtext">{{ section.settings.subtext }}</p>
    {% endif %}

    <div class="newsletter-section__form-wrap">
      {% form 'customer', class: 'newsletter-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">

        {% if form.posted_successfully? %}
          <div class="newsletter-form__success">
            {% render 'icon', name: 'check', size: 18 %}
            <span>Thank you for subscribing to our newsletter!</span>
          </div>
        {% else %}
          <div class="newsletter-form__row">
            <input
              type="email"
              name="contact[email]"
              id="NewsletterEmail-{{ section.id }}"
              value="{{ form.email }}"
              placeholder="Enter your email address"
              required
              class="newsletter-form__input"
              aria-label="Email address"
            >
            <button type="submit" class="btn btn-primary newsletter-form__btn">
              {{ section.settings.button_label | default: 'Subscribe' }}
            </button>
          </div>

          {% if form.errors %}
            <div class="newsletter-form__error text-danger mt-2">
              {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
            </div>
          {% endif %}
        {% endif %}
      {% endform %}
    </div>

    {% if section.settings.disclaimer != blank %}
      <p class="newsletter-section__disclaimer text-muted">{{ section.settings.disclaimer }}</p>
    {% endif %}
  </div>
</div>

{% stylesheet %}
  .newsletter-section {
    background-color: var(--newsletter-bg, #f7f7f7);
    color: var(--newsletter-color, #111111);
    padding: 70px 20px;
  }

  .newsletter-section__title {
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    font-weight: 600;
    margin-bottom: 12px;
    color: inherit;
  }

  .newsletter-section__subtext {
    max-width: 520px;
    margin: 0 auto 28px;
    font-size: 1rem;
    line-height: 1.5;
    color: inherit;
    opacity: 0.9;
  }

  .newsletter-section__form-wrap {
    max-width: 480px;
    margin: 0 auto;
  }

  .newsletter-form__row {
    display: flex;
    gap: 10px;
  }

  .newsletter-form__input {
    flex: 1;
    padding: 13px 16px;
    border: 1px solid #dcdcdc;
    border-radius: var(--style-border-radius-inputs, 2px);
    font-size: 0.95rem;
  }

  .newsletter-form__btn {
    white-space: nowrap;
  }

  .newsletter-form__success {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 14px 24px;
    background-color: #e8f5e9;
    color: #2e7d32;
    border-radius: 4px;
    font-weight: 500;
  }

  .newsletter-section__disclaimer {
    margin-top: 16px;
    font-size: 0.78rem;
  }

  @media (max-width: 576px) {
    .newsletter-form__row {
      flex-direction: column;
    }
    .newsletter-form__btn {
      width: 100%;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join Our Community"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Sign up for early access to new arrivals, sustainable product insights, and 10% off your first order."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "Disclaimer Text",
      "default": "By signing up, you agree to receive email marketing. Unsubscribe anytime."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#f7f7f7"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#111111"
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
