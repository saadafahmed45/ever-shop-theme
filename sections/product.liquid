<div class="product-page py-5 ">
<div class="container">
  
  <div class="product-wrapper">

    <!-- LEFT: IMAGE GALLERY -->
    <div class="product-gallery">

      <div class="main-image">
        <img id="mainProductImage" src="{{ product.featured_image | image_url: width: 900 }}">
      </div>

      <div class="thumb-images">
        {% for image in product.images %}
          <img 
            src="{{ image | image_url: width: 200 }}" 
            class="thumb" 
            onclick="changeImage(this.src)"
          >
        {% endfor %}
      </div>

    </div>

    <!-- RIGHT -->
    <div class="product-details">

      <h1>{{ product.title }}</h1>

      <!-- PRICE -->
      <div class="price-box">
        {% if product.compare_at_price > product.price %}
          <span>{{ product.price | money }}</span>
          <span style="text-decoration:line-through;">
            {{ product.compare_at_price | money }}
          </span>
        {% else %}
          <span>{{ product.price | money }}</span>
        {% endif %}
      </div>

      {% form 'product', product %}
        {% assign current_variant = product.selected_or_first_available_variant %}

        <!-- VARIANT FIX -->
        {% if product.variants.size > 1 %}
          <select name="id">
            {% for variant in product.variants %}
              <option value="{{ variant.id }}">
                {{ variant.title }}
              </option>
            {% endfor %}
          </select>
        {% else %}
          <input type="hidden" name="id" value="{{ current_variant.id }}">
        {% endif %}

        <!-- QTY -->
        <div class="qty-box">
          <button type="button" class="minus">-</button>
          <input type="number" name="quantity" value="1" min="1">
          <button type="button" class="plus">+</button>
        </div>

        <!-- AJAX BUTTON -->
        <button type="button" class="add-cart-btn ajax-add">
          Add to Cart
        </button>

      {% endform %}

    </div>

  </div>
</div>
</div>

<style>
.product-wrapper {
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 60px;
}

.main-image {
  background: #f8f8f8;
  padding: 20px;
  border-radius: 12px;
}

.main-image img {
  width: 100%;
  object-fit: contain;
}

.thumb-images {
  display: flex;
  gap: 10px;
  margin-top: 15px;
}

.thumb {
  width: 70px;
  height: 70px;
  object-fit: cover;
  border-radius: 8px;
  border: 1px solid #eee;
  cursor: pointer;
  transition: 0.3s;
}

.thumb:hover {
  border-color: #000;
  transform: scale(1.05);
}

.product-details h1 {
  font-size: 30px;
  font-weight: 600;
  margin-bottom: 10px;
}

.price-box {
  margin: 15px 0;
  display: flex;
  gap: 10px;
  align-items: center;
}

.price-box span:first-child {
  font-size: 26px;
  font-weight: bold;
}

.price-box span:last-child {
  color: #999;
}

select {
  width: 100%;
  padding: 12px;
  border-radius: 6px;
  border: 1px solid #ddd;
  margin-bottom: 15px;
}

.qty-box {
  display: flex;
  align-items: center;
  margin: 20px 0;
}

.qty-box input {
  width: 60px;
  text-align: center;
  padding: 10px;
  border: 1px solid #ddd;
}

.minus, .plus {
  padding: 10px 15px;
  border: none;
  background: #eee;
  cursor: pointer;
}

.add-cart-btn {
  width: 100%;
  background: #111;
  color: #fff;
  padding: 15px;
  border-radius: 8px;
  font-weight: 600;
  transition: 0.3s;
}

.add-cart-btn:hover {
  background: #333;
}

/* MOBILE */
@media (max-width: 768px) {
  .product-wrapper {
    grid-template-columns: 1fr;
  }
}
</style>

<script>
// CHANGE IMAGE
function changeImage(src) {
  document.getElementById("mainProductImage").src = src;
}

// QTY BUTTON
document.addEventListener("DOMContentLoaded", () => {

  const plus = document.querySelector(".plus");
  const minus = document.querySelector(".minus");
  const qty = document.querySelector("input[name='quantity']");

  plus?.addEventListener("click", () => qty.value++);
  minus?.addEventListener("click", () => {
    if (qty.value > 1) qty.value--;
  });

  // 🔥 AJAX ADD TO CART
  const btn = document.querySelector(".ajax-add");

  btn?.addEventListener("click", () => {

    const form = document.querySelector("form[action*='/cart/add']");
    const formData = new FormData(form);

    fetch('/cart/add.js', {
      method: 'POST',
      body: formData
    })
    .then(res => res.json())
    .then(data => {

      console.log("Added:", data);

      showToast("✅ Added to cart");
      updateCartCount();

    })
    .catch(err => {
      console.error(err);
      showToast("❌ Error adding product");
    });

  });

});

const btn = document.querySelector(".ajax-add");

btn?.addEventListener("click", () => {
  btn.innerText = "Adding...";
  btn.disabled = true;

  const form = document.querySelector("form[action*='/cart/add']");
  const formData = new FormData(form);

  fetch('/cart/add.js', {
    method: 'POST',
    body: formData
  })
  .then(res => res.json())
  .then(() => {
    btn.innerText = "Added ✅";
    setTimeout(() => {
      btn.innerText = "Add to Cart";
      btn.disabled = false;
    }, 1500);
  });
});
// TOAST
function showToast(msg) {
  const div = document.createElement("div");
  div.innerText = msg;
  div.style.position = "fixed";
  div.style.bottom = "20px";
  div.style.right = "20px";
  div.style.background = "black";
  div.style.color = "white";
  div.style.padding = "10px";
  div.style.borderRadius = "5px";
  document.body.appendChild(div);

  setTimeout(() => div.remove(), 2000);
}

// CART COUNT
function updateCartCount() {
  fetch('/cart.js')
    .then(res => res.json())
    .then(cart => {
      const el = document.getElementById("cart-count");
      if (el) el.innerText = cart.item_count;
    });
}
</script>

{% schema %}
{
  "name": "t:general.product",
  "settings": [],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}


