<div class="product-page py-5 ">
<div class="container">
  
  <div class="product-wrapper">

    <!-- LEFT: IMAGE GALLERY -->
    <div class="product-gallery">

      <!-- MAIN IMAGE -->
      <div class="main-image">
        <img id="mainProductImage" src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.title }}">
      </div>

      <!-- THUMBNAILS -->
      <div class="thumb-images">
        {% for image in product.images %}
          <img 
            src="{{ image | image_url: width: 200 }}" 
            class="thumb" 
            onclick="changeImage(this.src)"
          >
        {% endfor %}
      </div>

    </div>

    <!-- RIGHT: PRODUCT INFO -->
    <div class="product-details">

      <p class="product-category">{{ product.type }}</p>

      <h1 class="product-title">{{ product.title }}</h1>

      <!-- PRICE -->
      <div class="price-box">
        {% if product.compare_at_price > product.price %}
          <span class="new-price">{{ product.price | money }}</span>
          <span class="old-price">{{ product.compare_at_price | money }}</span>
          <span class="discount">30% OFF</span>
        {% else %}
          <span class="new-price">{{ product.price | money }}</span>
        {% endif %}
      </div>

      <div class="product-description">
        {{ product.description | strip_html | truncate: 180 }}
      </div>

      {% form 'product', product %}
        {% assign current_variant = product.selected_or_first_available_variant %}

        <!-- VARIANTS -->
        {% if product.variants.size > 1 %}
        <label class="label">Select Size</label>
        <select name="id" class="select-box">
          {% for variant in product.variants %}
            <option value="{{ variant.id }}" {% if variant == current_variant %}selected{% endif %}>
              {{ variant.title }}
            </option>
          {% endfor %}
        </select>
        {% endif %}

        <!-- QUANTITY -->
        <div class="qty-box">
          <button type="button" class="qty-btn minus">-</button>
          <input type="number" name="quantity" value="1" min="1">
          <button type="button" class="qty-btn plus">+</button>
        </div>

        <!-- BUTTON -->
        <button type="submit" class="add-cart-btn">
          Add to Cart
        </button>

        <div class="buy-now">
          {{ form | payment_button }}
        </div>

      {% endform %}

    </div>

  </div>
</div>
</div>

<style>


/* GRID */
.product-wrapper {
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 60px;
}

/* IMAGE */
.main-image {
  background: #f6f6f6;
  border-radius: 10px;
  padding: 20px;
}

.main-image img {
  width: 100%;
  object-fit: contain;
}

/* THUMBS */
.thumb-images {
  display: flex;
  gap: 12px;
  margin-top: 15px;
}

.thumb {
  width: 65px;
  height: 65px;
  object-fit: cover;
  cursor: pointer;
  border-radius: 6px;
  border: 1px solid #eee;
  transition: 0.3s;
}

.thumb:hover {
  border-color: #111;
}

/* DETAILS */
.product-details {
  position: sticky;
  top: 100px;
}

.product-category {
  font-size: 13px;
  color: #888;
  margin-bottom: 5px;
}

.product-title {
  font-size: 32px;
  font-weight: 600;
  margin-bottom: 10px;
}

/* PRICE */
.price-box {
  display: flex;
  align-items: center;
  gap: 10px;
  margin: 15px 0;
}

.new-price {
  font-size: 26px;
  font-weight: 600;
  color: #111;
}

.old-price {
  text-decoration: line-through;
  color: #999;
}

.discount {
  font-size: 12px;
  background: #ffe5e5;
  color: #e63946;
  padding: 3px 8px;
  border-radius: 4px;
}

/* DESCRIPTION */
.product-description {
  color: #666;
  line-height: 1.6;
  margin-bottom: 25px;
}

/* SELECT */
.select-box {
  width: 100%;
  padding: 12px;
  border: 1px solid #ddd;
  margin-bottom: 20px;
}

/* QTY */
.qty-box {
  display: flex;
  align-items: center;
  margin-bottom: 20px;
}

.qty-box input {
  width: 60px;
  text-align: center;
  padding: 10px;
  border: 1px solid #ddd;
}

.qty-btn {
  padding: 10px 15px;
  background: #f2f2f2;
  border: none;
  cursor: pointer;
}

/* BUTTON */
.add-cart-btn {
  width: 100%;
  background: #111;
  color: #fff;
  padding: 15px;
  border-radius: 6px;
  font-weight: 600;
  transition: 0.3s;
}

.add-cart-btn:hover {
  background: #333;
}

.buy-now {
  margin-top: 10px;
}

/* MOBILE */
@media (max-width: 768px) {
  .product-wrapper {
    grid-template-columns: 1fr;
  }

  .product-details {
    position: static;
  }
}
</style>

<script>
function changeImage(src) {
  document.getElementById("mainProductImage").src = src;
}

document.addEventListener("DOMContentLoaded", () => {
  const plus = document.querySelector(".plus");
  const minus = document.querySelector(".minus");
  const qty = document.querySelector("input[name='quantity']");

  plus?.addEventListener("click", () => qty.value++);
  minus?.addEventListener("click", () => {
    if (qty.value > 1) qty.value--;
  });
});
</script>

{% schema %}
{
  "name": "t:general.product",
  "settings": [],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
