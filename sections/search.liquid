<div class="search-page py-5">
<div class="container">
  
  <!-- TOP SEARCH BAR -->
  <div class="search-top">
    <form action="{{ routes.search_url }}" method="get">
      <input
        type="search"
        name="q"
        value="{{ search.terms | escape }}"
        placeholder="Search"
      >
      <button type="submit">Cancel</button>
    </form>
  </div>

 

  <!-- SEARCH RESULTS -->
  {% if search.performed %}
    <div class="search-results">

      {% if search.results_count == 0 %}
        <p>No results found</p>
      {% else %}

        <div class="products-grid">
          {% for result in search.results %}
            {% if result.object_type == 'product' %}
              <a href="{{ result.url }}" class="product-card">
                <img src="{{ result.featured_image | image_url: width: 400 }}">
                <p>{{ result.title }}</p>
              </a>
            {% endif %}
          {% endfor %}
        </div>

      {% endif %}

    </div>
  {% endif %}


   <!-- POPULAR CATEGORIES -->
  <div class="popular-section mt-5">
    <h3>Popular Categories</h3>

    <div class="popular-grid">

      {% for collection in collections limit: 4 %}
        <a href="{{ collection.url }}" class="popular-card">

          <div class="popular-image">
            <img src="{{ collection.featured_image | image_url: width: 500 }}" alt="{{ collection.title }}">
          </div>

          <p class="popular-title">{{ collection.title }}</p>

        </a>
      {% endfor %}

     </div>
  </div>
</div>
</div>
{% stylesheet %}


/* SEARCH BAR */
.search-top {
  margin-bottom: 40px;
}

.search-top form {
  display: flex;
  align-items: center;
  gap: 10px;
}

.search-top input {
  flex: 1;
  padding: 14px;
  border: none;
  background: #f3f3f3;
  border-radius: 6px;
  font-size: 14px;
}

.search-top button {
  background: none;
  border: none;
  color: #777;
  cursor: pointer;
}

/* POPULAR SECTION */
.popular-section h3 {
  font-size: 14px;
  color: #777;
  margin-bottom: 20px;
}

/* GRID */
.popular-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 25px;
}

/* CARD */
.popular-card {
  text-decoration: none;
  color: #111;
}

/* IMAGE */
.popular-image {
  background: #eee;
  overflow: hidden;
}

.popular-image img {
  width: 100%;
  height: 260px;
  object-fit: cover;
  transition: 0.4s;
}

.popular-card:hover img {
  transform: scale(1.05);
}

/* TITLE */
.popular-title {
  margin-top: 8px;
  font-size: 13px;
  color: #555;
}

/* SEARCH RESULTS GRID */
.products-grid {
  margin-top: 40px;
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 30px;
}

/* MOBILE */
@media (max-width: 768px) {
  .popular-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}
{% endstylesheet %}

{% schema %}
{
  "name": "t:general.search",
  "settings": []
}
{% endschema %}
