<div class="testimonials-section" id="Testimonials-{{ section.id }}">
  <div class="container">

    {% if section.settings.heading != blank or section.settings.sub_heading != blank %}
      <div class="testimonials__header text-center">
        {% if section.settings.heading != blank %}
          <h2 class="testimonials__title">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.sub_heading != blank %}
          <p class="testimonials__subtitle text-muted">{{ section.settings.sub_heading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="testimonials__grid" style="--columns: {{ section.settings.columns | default: 3 }};">
      {% for block in section.blocks %}
        <div class="testimonial-card" {{ block.shopify_attributes }}>
          <div class="testimonial-card__stars" aria-label="{{ block.settings.rating }} stars out of 5">
            {% for i in (1..block.settings.rating) %}
              {% render 'icon', name: 'star', size: 16, class: 'star-icon' %}
            {% endfor %}
          </div>

          <blockquote class="testimonial-card__quote">
            “{{ block.settings.quote }}”
          </blockquote>

          <div class="testimonial-card__author">
            <span class="testimonial-card__author-name">{{ block.settings.author }}</span>
            {% if block.settings.author_title != blank %}
              <span class="testimonial-card__author-title text-muted">{{ block.settings.author_title }}</span>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>

  </div>
</div>

{% stylesheet %}
  .testimonials-section {
    padding: 70px 0;
    background-color: #fbfbfb;
  }

  .testimonials__header {
    margin-bottom: 44px;
  }

  .testimonials__title {
    font-size: clamp(1.6rem, 3vw, 2.3rem);
    font-weight: 600;
    margin-bottom: 8px;
  }

  .testimonials__subtitle {
    font-size: 0.95rem;
  }

  .testimonials__grid {
    display: grid;
    grid-template-columns: repeat(var(--columns, 3), minmax(0, 1fr));
    gap: 30px;
  }

  .testimonial-card {
    background-color: #ffffff;
    border: 1px solid #eeeeee;
    border-radius: var(--style-border-radius-inputs, 4px);
    padding: 32px 28px;
    display: flex;
    flex-direction: column;
    height: 100%;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .testimonial-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
  }

  .testimonial-card__stars {
    display: flex;
    gap: 3px;
    color: #111111;
    margin-bottom: 18px;
  }

  .testimonial-card__quote {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #333333;
    margin-bottom: 24px;
    flex-grow: 1;
    font-style: italic;
  }

  .testimonial-card__author {
    display: flex;
    flex-direction: column;
  }

  .testimonial-card__author-name {
    font-size: 0.9rem;
    font-weight: 600;
    color: #111111;
  }

  .testimonial-card__author-title {
    font-size: 0.8rem;
    margin-top: 2px;
  }

  @media (max-width: 992px) {
    .testimonials__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 20px;
    }
  }

  @media (max-width: 600px) {
    .testimonials-section {
      padding: 48px 0;
    }
    .testimonials__grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
    .testimonial-card {
      padding: 24px 20px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Customer Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Our Customers Say"
    },
    {
      "type": "text",
      "id": "sub_heading",
      "label": "Sub Heading",
      "default": "Over 50,000 five-star reviews from conscious shoppers worldwide."
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Columns (Desktop)",
      "default": 3
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Star Rating",
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Customer Quote",
          "default": "The quality of the fabric and the fit are exceptional. Easily the most comfortable everyday sweater I own."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Customer Name",
          "default": "Sarah M."
        },
        {
          "type": "text",
          "id": "author_title",
          "label": "Location / Verified Buyer",
          "default": "Verified Buyer, New York"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer Testimonials",
      "blocks": [
        {
          "type": "testimonial",
          "settings": {
            "rating": 5,
