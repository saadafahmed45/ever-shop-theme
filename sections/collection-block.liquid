<div class="collection-block">
  <div class="container">
    <div class="collection-row">

      {% for block in section.blocks %}
      <div class="collection-item">

        <a href="{{ block.settings.collection_link }}">

          <!-- IMAGE -->
          <div class="collection-img">
            {% if block.settings.collection_image %}
              <img src="{{ block.settings.collection_image | image_url: width: 900 }}" alt="">
            {% else %}
              {{ 'collection-1' | placeholder_svg_tag }}
            {% endif %}

            <!-- OVERLAY -->
            <div class="overlay">
              <h2>{{ block.settings.collection_title }}</h2>
              <span class="btn">{{ block.settings.collection_Button_Text }}</span>
            </div>
          </div>

        </a>

      </div>
      {% endfor %}

    </div>
  </div>
</div>

<style>
.collection-block {
  padding: 100px 0px;
  background: #f5f5f5;
}

.collection-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 25px;
}

.collection-item {
  position: relative;
  overflow: hidden;
  border-radius: 5px;
}

/* IMAGE */
.collection-img {
  position: relative;
}

.collection-img img {
  width: 100%;
  height: 500px;
  object-fit: cover;
  transition: 0.5s;
}

/* OVERLAY */
.overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.35);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 15px;
  color: #fff;
  text-align: center;
  transition: 0.4s;
}

/* TEXT */
.overlay h2 {
  font-size: 32px;
  font-weight: 600;
  letter-spacing: 1px;
}

/* BUTTON */
.overlay .btn {
  background: #fff;
  color: #111;
  padding: 10px 22px;
  font-size: 14px;
  letter-spacing: 1px;
  border-radius: 2px;
  transition: 0.3s;
}

.overlay .btn:hover {
  background: #000;
  color: #fff;
}

/* HOVER EFFECT */
.collection-item:hover img {
  transform: scale(1.08);
}

.collection-item:hover .overlay {
  background: rgba(0,0,0,0.5);
}

/* TABLET */
@media (max-width: 992px) {
  .collection-row {
    grid-template-columns: repeat(2, 1fr);
  }
}

/* MOBILE */
@media (max-width: 600px) {
  .collection-row {
    grid-template-columns: 1fr;
  }

  .collection-img img {
    height: 300px;
  }

  .overlay h2 {
    font-size: 24px;
  }
}
</style>

{% schema %}
{
  "name": "Collection Block",
  "tag": "section",
  "settings": [],
  "blocks": [
    {
      "type": "block",
      "name": "Collection Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "collection_image",
          "label": "Collection Image"
        },
        {
          "type": "text",
          "id": "collection_title",
          "label": "Title",
          "default": "New Arrivals"
        },
        {
          "type": "text",
          "id": "collection_Button_Text",
          "label": "Button Text",
          "default": "SHOP NOW"
        },
        {
          "type": "url",
          "id": "collection_link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Block",
      "blocks": [
        { "type": "block" },
        { "type": "block" },
        { "type": "block" }
      ]
    }
  ]
}
{% endschema %}