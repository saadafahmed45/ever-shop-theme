<div class="collection-block" id="CollectionBlock-{{ section.id }}">
  <div class="container">

    {% if section.settings.heading != blank or section.settings.sub_heading != blank %}
      <div class="collection-block__header text-center">
        {% if section.settings.heading != blank %}
          <h2 class="collection-block__heading">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.sub_heading != blank %}
          <p class="collection-block__subheading text-muted">{{ section.settings.sub_heading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="collection-block__row">
      {% for block in section.blocks %}
        {%- liquid
          assign btn_text = block.settings.collection_button_text | default: block.settings.collection_Button_Text | default: 'SHOP NOW'
          assign link_url = block.settings.collection_link | default: '#'
          assign item_title = block.settings.collection_title | default: 'Collection'
          assign item_image = block.settings.collection_image
        -%}

        <div class="collection-block__item" {{ block.shopify_attributes }}>
          <a href="{{ link_url }}" class="collection-block__card">
            <div class="collection-block__img-wrap">
              {% if item_image != blank %}
                <img
                  src="{{ item_image | image_url: width: 900, height: 1100, crop: 'center' }}"
                  alt="{{ item_image.alt | default: item_title | escape }}"
                  width="900"
                  height="1100"
                  loading="lazy"
                  class="collection-block__img"
                >
              {% else %}
                <div class="collection-block__placeholder">
                  {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                </div>
              {% endif %}

              <div class="collection-block__overlay">
                <h3 class="collection-block__title">{{ item_title }}</h3>
                <span class="btn btn-secondary btn-sm collection-block__btn">{{ btn_text }}</span>
              </div>
            </div>
          </a>
        </div>
      {% endfor %}
    </div>

  </div>
</div>

{% stylesheet %}
  .collection-block {
    padding: 70px 0;
    background-color: #f9f9f9;
  }

  .collection-block__header {
    margin-bottom: 36px;
  }

  .collection-block__heading {
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    font-weight: 600;
    margin-bottom: 8px;
  }

  .collection-block__subheading {
    font-size: 0.95rem;
  }

  .collection-block__row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .collection-block__card {
    display: block;
    position: relative;
    overflow: hidden;
    border-radius: var(--style-border-radius-inputs, 4px);
    text-decoration: none;
  }

  .collection-block__img-wrap {
    position: relative;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background-color: #eeeeee;
  }

  .collection-block__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .collection-block__card:hover .collection-block__img {
    transform: scale(1.06);
  }

  .collection-block__placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .collection-block__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.1) 0%, rgba(0, 0, 0, 0.45) 100%);
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    padding: 32px 20px;
    gap: 14px;
    color: #ffffff;
    text-align: center;
    transition: background 0.3s ease;
  }

  .collection-block__card:hover .collection-block__overlay {
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.15) 0%, rgba(0, 0, 0, 0.6) 100%);
  }

  .collection-block__title {
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: #ffffff;
    margin: 0;
  }

  .collection-block__btn {
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.2);
  }

  @media (max-width: 992px) {
    .collection-block__row {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }

  @media (max-width: 600px) {
    .collection-block {
      padding: 48px 0;
    }
    .collection-block__row {
      grid-template-columns: 1fr;
    }
    .collection-block__title {
      font-size: 1.3rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection Block",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "sub_heading",
      "label": "Sub Heading"
    }
  ],
  "blocks": [
    {
      "type": "block",
      "name": "Collection Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "collection_image",
          "label": "Collection Image"
        },
        {
          "type": "text",
          "id": "collection_title",
          "label": "Title",
          "default": "New Arrivals"
        },
        {
          "type": "text",
          "id": "collection_button_text",
          "label": "Button Text",
          "default": "SHOP NOW"
        },
        {
          "type": "url",
          "id": "collection_link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Block",
      "blocks": [
        { "type": "block" },
        { "type": "block" },
        { "type": "block" }
      ]
    }
  ]
}
{% endschema %}