{% if product.collections.size > 0 %}
  {% assign related_collection = product.collections.first %}

  <div class="related-products-section" id="RelatedProducts-{{ section.id }}">
    <div class="container">

      <div class="related-products__header text-center">
        <h2 class="related-products__title">
          {{ section.settings.heading | default: 'You May Also Like' }}
        </h2>
        {% if section.settings.sub_heading != blank %}
          <p class="related-products__subtitle text-muted">
            {{ section.settings.sub_heading }}
          </p>
        {% endif %}
      </div>

      <div class="related-products__grid">
        {% assign count = 0 %}
        {% for item in related_collection.products %}
          {% if item.id != product.id and count < section.settings.products_to_show %}
            <div class="related-products__item">
              {% render 'product-card', product: item %}
            </div>
            {% assign count = count | plus: 1 %}
          {% endif %}
        {% endfor %}
      </div>

    </div>
  </div>
{% endif %}

{% stylesheet %}
  .related-products-section {
    padding: 70px 0;
    border-top: 1px solid #eeeeee;
    background-color: #ffffff;
  }

  .related-products__header {
    margin-bottom: 40px;
  }

  .related-products__title {
    font-size: clamp(1.5rem, 3vw, 2.2rem);
    font-weight: 600;
    margin-bottom: 8px;
  }

  .related-products__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
  }

  @media (max-width: 992px) {
    .related-products__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }
  }

  @media (max-width: 768px) {
    .related-products-section {
      padding: 48px 0;
    }
    .related-products__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 12px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Related Products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You May Also Like"
    },
    {
      "type": "text",
      "id": "sub_heading",
      "label": "Sub Heading",
      "default": "Pairs well with your wardrobe favorites"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Products to Show",
      "default": 4
    }
  ],
  "presets": [
    {
      "name": "Related Products"
    }
  ]
}
{% endschema %}