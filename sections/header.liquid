<header class="site-header bg-white sticky-top shadow-sm">
  <div class="container-fluid px-lg-5">

    <!-- TOP HEADER -->
    <div class="row align-items-center border-bottom py-3">

      <!-- MOBILE MENU BUTTON -->
      <div class="col-2 d-lg-none">
        <button class="btn p-0" data-bs-toggle="offcanvas" data-bs-target="#mobileMenu">
          ☰
        </button>
      </div>

      <!-- DESKTOP MENU -->
      <nav class="col-lg-4 d-none d-lg-block">
        <ul class="list-unstyled d-flex gap-4 mb-0">
          {% for link in section.settings.menu.links %}
            <li>
              <a href="{{ link.url }}" 
                 class="nav-link-custom {% if link.active %}active{% endif %}">
                 {{ link.title }}
              </a>
            </li>
          {% endfor %}
        </ul>
      </nav>

      <!-- LOGO -->
      <div class="col-8 col-lg-4 text-center">
        <a href="{{ routes.root_url }}" class="logo-text">
          {{ shop.name }}
        </a>
      </div>

      <!-- RIGHT ICONS -->
      <div class="col-2 col-lg-4 text-end d-flex justify-content-end gap-3 align-items-center">

        <!-- SEARCH ICON -->
        <a href="/search" class="icon-btn">
       <i class="fa-solid fa-magnifying-glass"></i>
        </a>

        <!-- ACCOUNT -->
        {% if shop.customer_accounts_enabled %}
          <a href="{{ routes.account_url }}" class="icon-btn d-none d-sm-inline-block">
          <i class="fa-solid fa-user"></i>
          </a>
        {% endif %}

        <!-- CART -->
        <a href="{{ routes.cart_url }}" class="icon-btn position-relative">
       <i class="fa-solid fa-cart-shopping"></i>
          {% if cart.item_count > 0 %}
            <span class="cart-badge">{{ cart.item_count }}</span>
          {% endif %}
        </a>

      </div>
    </div>

    <!-- SUB HEADER -->
    {% if section.settings.sub_menu.links.size > 0 %}
    <div class="sub_header d-none d-lg-block">
      <div class="container">
        <ul class="nav justify-content-center">
          {% for link in section.settings.sub_menu.links %}
            <li class="nav-item">
              <a href="{{ link.url }}" class="nav-link sub-link">
                {{ link.title }}
              </a>
            </li>
          {% endfor %}
        </ul>
      </div>
    </div>
    {% endif %}

  </div>
</header>

<!-- MOBILE MENU -->
<div class="offcanvas offcanvas-start" id="mobileMenu">
  <div class="offcanvas-header border-bottom">
    <h5>{{ shop.name }}</h5>
    <button class="btn-close" data-bs-dismiss="offcanvas"></button>
  </div>

  <div class="offcanvas-body">

    <!-- MAIN MENU -->
    <nav class="nav flex-column gap-3">
      {% for link in section.settings.menu.links %}
        <a href="{{ link.url }}" class="mobile-link">
          {{ link.title }}
        </a>
      {% endfor %}
    </nav>

    <!-- SUB MENU -->
    {% if section.settings.sub_menu.links.size > 0 %}
      <div class="mt-4">
        <span class="mobile-heading">
          {{ section.settings.Sub_menu_heading }}
        </span>

        <nav class="nav flex-column gap-2 mt-2">
          {% for link in section.settings.sub_menu.links %}
            <a href="{{ link.url }}" class="mobile-sub-link">
              {{ link.title }}
            </a>
          {% endfor %}
        </nav>
      </div>
    {% endif %}

  </div>
</div>

<style>

/* LOGO */
.logo-text {
  font-size: 22px;
  font-weight: 700;
  color: #111;
  text-decoration: none;
}

/* NAV LINK */
.nav-link-custom {
  position: relative;
  text-decoration: none;
  color: #666;
  font-size: 13px;
  font-weight: 600;
  text-transform: uppercase;
  transition: all 0.3s ease;
}

/* COOL HOVER EFFECT 🔥 */
.nav-link-custom::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: -5px;
  width: 0%;
  height: 2px;
  background: #000;
  transition: 0.3s;
}

.nav-link-custom:hover {
  color: #000;
}

.nav-link-custom:hover::after {
  width: 100%;
}

.nav-link-custom.active {
  color: #000;
}

.nav-link-custom.active::after {
  width: 100%;
}

/* ICON BUTTON */
.icon-btn {
  font-size: 18px;
  text-decoration: none;
  color: #333;
  transition: 0.3s;
}

.icon-btn:hover {
  transform: scale(1.2);
  color: #000;
}

/* CART BADGE */
.cart-badge {
  position: absolute;
  top: -6px;
  right: -10px;
  background: #000;
  color: #fff;
  font-size: 10px;
  width: 18px;
  height: 18px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* SUB HEADER */
.sub_header {
  background: #f8f9fa;
  padding: 8px 0;
}

.sub-link {
  color: #555;
  font-size: 14px;
  text-transform: uppercase;
  transition: 0.3s;
}

.sub-link:hover {
  color: #000;
}

/* MOBILE MENU */
.mobile-link {
  text-decoration: none;
  font-weight: 600;
  color: #222;
}

.mobile-sub-link {
  text-decoration: none;
  color: #666;
  font-size: 14px;
}

.mobile-heading {
  font-size: 14px;
  font-weight: 700;
  color: #999;
}

</style>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu"
    },
    {
      "type": "link_list",
      "id": "sub_menu",
      "label": "Sub Menu"
    },
    {
      "type": "text",
      "id": "Sub_menu_heading",
      "label": "Mobile Sub Menu Heading",
      "default": "Category"
    }
  ]
}
{% endschema %}