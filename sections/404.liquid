<div class="error-404-section text-center">
  <div class="container container-narrow">
    <span class="error-404__eyebrow">404</span>
    <h1 class="error-404__title">{{ '404.title' | t }}</h1>
    <p class="error-404__text text-muted">
      {{ '404.not_found' | t }} The page you are looking for might have been moved or removed.
    </p>
    <a href="{{ routes.all_products_collection_url }}" class="btn btn-primary btn-lg">
      {{ '404.back_to_shopping' | t }}
    </a>
  </div>
</div>

{% stylesheet %}
  .error-404-section {
    padding: 100px 20px 120px;
  }

  .error-404__eyebrow {
    font-size: 5rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    color: #e5e5e5;
    display: block;
    margin-bottom: 10px;
  }

  .error-404__title {
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 600;
    margin-bottom: 16px;
  }

  .error-404__text {
    max-width: 480px;
    margin: 0 auto 32px;
    font-size: 1rem;
    line-height: 1.6;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "404 Error Page",
  "settings": []
}
{% endschema %}
